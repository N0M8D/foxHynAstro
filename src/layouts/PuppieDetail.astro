---
import Layout from "../layouts/Layout.astro";
import Gallery from "../components/Gallery.astro";

type Props = {
    name: string;
    title?: string;
    facts?: { label: string; value: string }[];
    gallery?: string[];
    backHref?: string;
};
const { name, title, facts = [], gallery = [], backHref = "./" } = Astro.props;
---

<Layout title={title || name} description={name}>
    <article class="puppy-detail">
        <a href={backHref} class="back-link">← Zpět</a>

        <h1>{name}</h1>
        <slot />

        {title && <h2>{title}</h2>}
        {
            facts.length > 0 && (
                <ul>
                    {facts.map((f) => (
                        <li>
                            {f.label && <b>{f.label}</b>} {f.value}
                        </li>
                    ))}
                </ul>
            )
        }

        {gallery.length > 0 && <Gallery images={gallery} alt={name} />}
    </article>

    <style>
        .puppy-detail {
            margin: auto;
            padding: 2rem 1rem;
            color: rgb(var(--gray-dark));
        }
        .puppy-detail h1 {
            text-align: center;
            font-size: 2rem;
            margin-bottom: 1rem;
        }
        .puppy-detail ul {
            margin-top: 1.5rem;
            padding-left: 1rem;
            list-style: none;
        }
        .puppy-detail ul li {
            margin: 0.5rem 0;
        }
        .back-link {
            display: inline-block;
            margin: 2rem 0 1rem;
            color: var(--accent);
            text-decoration: none;
            font-weight: bold;
        }
        .back-link:hover {
            text-decoration: underline;
        }
    </style>
</Layout>
