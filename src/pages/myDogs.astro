---
import Layout from "../layouts/Layout.astro";
import DogCard from "../components/DogCard.astro";
import { getGroup, getProfiles } from "../lib/cms/content";

export const prerender = false;

let group, dogs;
try {
    [group, dogs] = await Promise.all([getGroup("smecka"), getProfiles("smecka")]);
} catch (error) {
    console.error("[myDogs] Načtení obsahu selhalo.", error);
    return new Response("Obsah je dočasně nedostupný.", { status: 503 });
}

const paragraphs = (body: string) =>
    body
        .split("\n\n")
        .map((p) => p.trim())
        .filter(Boolean);
---

<Layout title={group?.title ?? "Moje smečka"} description={group?.description}>
    <section class="my-dogs">
        <h1>{group?.title ?? "Moje smečka"}</h1>
        {group?.description && <p class="intro">{group.description}</p>}
        <div class="stack">
            {
                dogs.map((dog) => (
                    <DogCard
                        name={dog.title || dog.name}
                        imageUrl={dog.image ?? ""}
                        details={dog.facts}
                        description={paragraphs(dog.body)}
                    />
                ))
            }
        </div>
    </section>
</Layout>

<style>
    .my-dogs {
        max-width: 960px;
        margin: auto;
        padding: 3rem 1rem;
    }

    .my-dogs h1 {
        text-align: center;
        font-size: 2.5rem;
        margin-bottom: 1rem;
        color: rgb(var(--black));
    }

    .my-dogs .intro {
        text-align: center;
        color: rgb(var(--gray-dark));
        margin-bottom: 2rem;
    }

    .my-dogs .stack {
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }

    @media (max-width: 768px) {
        .my-dogs {
            padding: 2rem 1rem;
        }

        .my-dogs .stack {
            gap: 1.5rem;
        }
    }
</style>
