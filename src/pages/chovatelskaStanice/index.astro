---
import { marked } from "marked";
import Layout from "../../layouts/Layout.astro";
import LinkGrid from "../../components/LinkGrid.astro";
import { getChildGroups, getGroup } from "../../lib/cms/content";

export const prerender = false;

const SLUG = "chovatelska-stanice";

let group, litters;
try {
    [group, litters] = await Promise.all([getGroup(SLUG), getChildGroups(SLUG)]);
} catch (error) {
    console.error("[chovatelskaStanice] Načtení obsahu selhalo.", error);
    return new Response("Obsah je dočasně nedostupný.", { status: 503 });
}

const items = litters.map((l) => ({
    title: l.title,
    href: `/chovatelskaStanice/${l.slug}`,
    imageUrl: l.image ?? "",
}));
const content = await marked.parse(group?.body ?? "");
---

<Layout title={group?.title} description={group?.description}>
    <section class="chovna-stanice">
        <div class="prose">
            <h1>{group?.title ?? "Chovatelská stanice"}</h1>

            <h2>Naše vrhy</h2>
            <LinkGrid items={items} />

            <div set:html={content} />
        </div>
    </section>
</Layout>

<style>
    .chovna-stanice {
        max-width: 800px;
        margin: auto;
        padding: 3rem 1rem;
    }
    .chovna-stanice h1 {
        text-align: center;
        font-size: 2.5rem;
        margin-bottom: 1.5rem;
        color: rgb(var(--black));
    }
    .chovna-stanice :global(h2) {
        margin-top: 2rem;
        font-size: 1.75rem;
        color: rgb(var(--black));
    }
    .chovna-stanice :global(h3) {
        margin-top: 1.5rem;
        font-size: 1.25rem;
        color: rgb(var(--black));
    }
    .chovna-stanice .prose :global(p) {
        margin-bottom: 1rem;
        color: rgb(var(--gray-dark));
    }
    /* certifikát */
    .chovna-stanice :global(p:has(> img)) {
        text-align: center;
        margin: 2rem 0;
    }
    .chovna-stanice :global(img) {
        max-width: 500px;
        width: 100%;
        height: auto;
        border-radius: 8px;
        box-shadow: var(--box-shadow);
    }
</style>
