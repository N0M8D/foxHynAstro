---
import { marked } from "marked";
import ActivityDetail from "../../layouts/ActivityDetail.astro";
import { getPage } from "../../lib/cms/content";

export const prerender = false;

let page;
try {
    page = await getPage(Astro.params.slug ?? "", "activities");
} catch (error) {
    console.error("[activities] Načtení aktivity selhalo.", error);
    return new Response("Obsah je dočasně nedostupný.", { status: 503 });
}
if (!page) return new Response("Aktivita nenalezena.", { status: 404 });

const content = await marked.parse(page.body);
---

<ActivityDetail title={page.title} description={page.summary} gallery={page.gallery}>
    <div set:html={content} />
</ActivityDetail>
