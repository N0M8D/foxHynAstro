---
import Layout from "../../layouts/Layout.astro";
import LinkGrid from "../../components/LinkGrid.astro";
import { getGroup, getPages } from "../../lib/cms/content";

export const prerender = false;

let group, pages;
try {
    [group, pages] = await Promise.all([getGroup("activities"), getPages("activities")]);
} catch (error) {
    console.error("[activities] Načtení obsahu selhalo.", error);
    return new Response("Obsah je dočasně nedostupný.", { status: 503 });
}

const items = pages.map((p) => ({
    title: p.title,
    href: `/activities/${p.slug}`,
    imageUrl: p.image ?? "",
}));
---

<Layout title={group?.title ?? "Aktivity"} description={group?.description}>
    <section class="activities">
        <h1>{group?.title ?? "Aktivity"}</h1>
        {group?.description && <p class="activities__intro">{group.description}</p>}
        <LinkGrid items={items} />
    </section>
</Layout>

<style>
    .activities {
        max-width: 960px;
        margin: auto;
        padding: 3rem 1rem;
    }
    .activities h1 {
        text-align: center;
        font-size: 2.5rem;
        margin-bottom: 1rem;
        color: rgb(var(--black));
    }
    .activities__intro {
        text-align: center;
        color: rgb(var(--gray-dark));
        margin-bottom: 2rem;
    }
</style>
