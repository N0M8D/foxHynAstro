---
import BlogPost from "../../layouts/BlogPost.astro";
import { marked } from "marked";
import { findPost } from "../../lib/cms/blog";

export const prerender = false;

const slug = Astro.params.slug ?? "";

let found: Awaited<ReturnType<typeof findPost>>;
try {
	found = await findPost(slug);
} catch (error) {
	console.error(`[blog] Načtení článku "${slug}" selhalo.`, error);
	return new Response("Obsah je dočasně nedostupný.", { status: 503 });
}

if (!found) {
	return new Response("Článek nenalezen.", { status: 404 });
}
if (found.redirectTo) {
	return Astro.redirect(found.redirectTo, 301);
}

const { post } = found;
const content = await marked.parse(post.content || "");
---

<BlogPost {...post}>
	<div set:html={content} />
</BlogPost>
