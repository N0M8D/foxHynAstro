---
// src/components/Footer.astro
import SocialLinks from "./SocialLinks.astro";
const today = new Date();
---

<footer>
	&copy; {today.getFullYear()} Foxhyn.com. All rights reserved.
	<p>
		Created & designed by
		<a href="https://josefbouse.cz" target="_blank" rel="noopener">
			Josef Bouše
		</a>
		& Pavla Krausová
	</p>
	<p class="privacy-links">
		<a href="/privacy">Nastavení cookies a soukromí</a>
	</p>
	<SocialLinks />
</footer>

<style>
	footer {
		padding: 2em 1em 3em 1em;
		background: linear-gradient(var(--gray-gradient)) no-repeat;
		color: rgb(var(--gray));
		text-align: center;
	}

	.privacy-links {
		margin-top: 1rem;
		font-size: 0.9rem;
	}

	.privacy-links a {
		color: rgb(var(--gray));
		text-decoration: underline;
		opacity: 0.8;
		transition: opacity 0.2s ease;
	}

	.privacy-links a:hover {
		opacity: 1;
	}
</style>
