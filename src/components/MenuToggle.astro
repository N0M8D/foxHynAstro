<script is:inline>
    // @ts-nocheck
    // Client-side JavaScript pro menu toggle
    function initMenuToggle() {
        let menuOpen = false;

        const toggle = document.querySelector(".menu-toggle");
        const menu = document.querySelector(".internal-links");
        const social = document.querySelector(".social-wrapper");

        // Pokud chybí základní prvky, nic nespouštěj
        if (!toggle || !menu) return;
        // Zamez duplicitnímu bindování po navigacích
        if (toggle.dataset && toggle.dataset.bound === "true") return;
        if (toggle.dataset) toggle.dataset.bound = "true";

        const focusableElements = "a[href], button";
        let firstFocusable = null;
        let lastFocusable = null;

        const trapFocus = (e) => {
            if (!menuOpen) return;

            const focusables = document.querySelectorAll(focusableElements);
            firstFocusable = focusables[0];
            lastFocusable = focusables[focusables.length - 1];

            if (e.key === "Tab") {
                if (e.shiftKey) {
                    // Shift + Tab
                    if (document.activeElement === firstFocusable) {
                        e.preventDefault();
                        lastFocusable &&
                            typeof lastFocusable.focus === "function" &&
                            lastFocusable.focus();
                    }
                } else {
                    // Tab
                    if (document.activeElement === lastFocusable) {
                        e.preventDefault();
                        firstFocusable &&
                            typeof firstFocusable.focus === "function" &&
                            firstFocusable.focus();
                    }
                }
            } else if (e.key === "Escape") {
                closeMenu();
            }
        };

        const openMenu = () => {
            menuOpen = true;
            document.body.classList.add("menu-open");
            document.addEventListener("keydown", trapFocus);
        };

        const closeMenu = () => {
            menuOpen = false;
            document.body.classList.remove("menu-open");
            document.removeEventListener("keydown", trapFocus);
        };

        const toggleMenu = () => {
            menuOpen ? closeMenu() : openMenu();
        };

        toggle.addEventListener("click", toggleMenu);

        // Cleanup při navigaci
        document.addEventListener("astro:before-swap", () => {
            // Zavři menu před výměnou obsahu stránky
            if (menuOpen) closeMenu();
            toggle.removeEventListener("click", toggleMenu);
            document.removeEventListener("keydown", trapFocus);
        });
    }

    // Spustit po načtení DOM (nebo hned pokud je DOM už připraven)
    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initMenuToggle, {
            once: true,
        });
    } else {
        initMenuToggle();
    }

    // Spustit také při navigaci v Astro (view transitions)
    document.addEventListener("astro:page-load", initMenuToggle);
</script>
